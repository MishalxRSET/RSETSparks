rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRajagiriEmail() {
      return isAuthenticated() && 
        request.auth.token.email.matches('.*@rajagiri[.]edu[.]in$');
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId && isRajagiriEmail();
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAuthenticated();
    }
  }
}
