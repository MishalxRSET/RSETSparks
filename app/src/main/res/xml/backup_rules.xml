<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Nothing personal is backed up: chats and profiles live in Firebase and the
     Firestore offline cache must not be restored onto another device. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
