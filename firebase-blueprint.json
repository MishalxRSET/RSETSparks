{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student profile restricted to verified Rajagiri email accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "department": { "type": "string" },
        "year": { "type": "integer" },
        "bio": { "type": "string" },
        "interests": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "name", "department", "isVerified"]
    },
    "Report": {
      "title": "Report",
      "description": "Safety incident report against a user for campus moderation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterId": { "type": "string" },
        "reportedUserId": { "type": "string" },
        "reasonCategory": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterId", "reportedUserId", "reasonCategory", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Student user profile documents indexed by user ID."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Campus safety incident reports."
    }
  }
}
